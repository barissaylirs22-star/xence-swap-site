# Public Vite vars only — never put API secrets in the client build.
# Post-launch keyed Jupiter APIs should be proxied via a Worker.

# Optional Solana mainnet-beta read RPC (browser-friendly URL recommended).
# Official api.mainnet-beta.solana.com often 403s browser Origins.
# Default fallback chain uses publicnode if unset.
# VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# --- Holder concentration (REQUIRED for Token Intelligence holders) ---
# Server-only secret — used by Vite middleware + Cloudflare worker.
# Do NOT prefix with VITE_ (that would expose the key in the client bundle).
# HELIUS_API_KEY=
#
# Or set a full upstream URL instead of HELIUS_API_KEY:
# SOLANA_HOLDERS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Browser calls same-origin proxy (no key in the client):
# VITE_HOLDERS_RPC_PROXY_PATH=/api/solana-holders
#
# Production: same-origin Cloudflare Worker (workers/holders-rpc.js + wrangler.toml)
# serves /api/solana-holders and /api/holder-intel on axiom-swap.xyz.
# KV namespace (dashboard name): AXIOM_HOLDER_INTEL
# Worker binding: env.AXIOM_HOLDER_INTEL (see wrangler.toml)
# Manual secrets:
#   npx wrangler secret put HELIUS_API_KEY
#   npx wrangler deploy
# Dev/preview: Vite serves /api/solana-holders and /api/holder-intel automatically.
# Local history is stored under .data/holder-intel/ (gitignored), shared across browsers.
#
# Optional local data dir override:
# HOLDER_INTEL_DATA_DIR=.data/holder-intel
#
# Dev-only: allow POST observation.t backdating for history verification scripts.
# Never enable this on the Cloudflare Worker.
# HOLDER_INTEL_ALLOW_BACKDATE=1
#
# Note: getTokenLargestAccounts works on Helius Free for most SPL / Pump tokens.
# Mega-tokens (e.g. USDC, WSOL) may return "Too many accounts requested" — those
# settle as Unavailable (not fabricated).

# Optional market proxy base (post-launch)
# VITE_MARKET_PROXY_URL=https://market.axiom-swap.xyz

# Optional swap quote/tx proxy base (preferred for keyed access)
# VITE_SWAP_PROXY_URL=https://swap.axiom-swap.xyz

# Optional public Jupiter client key — prefer VITE_SWAP_PROXY_URL instead
# VITE_JUPITER_API_KEY=

# Optional Pump.fun realtime WebSocket URL (public or same-origin proxy).
# Default: wss://pumpportal.fun/api/data (no secret key).
# If a future provider needs a secret, proxy it server-side and set that proxy URL here.
# VITE_PUMP_WS_URL=wss://pumpportal.fun/api/data
